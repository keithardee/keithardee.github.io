# Copy this file to .env and fill in values. Do NOT commit .env with secrets.
# SMTP configuration (use your email provider or transactional email service)
# For Gmail, use an App Password (see README). Example settings for Gmail:

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-or-app-password

# Optional: override From and To addresses
# FROM_EMAIL=you@gmail.com
# TO_EMAIL=keithardeelazo@gmail.com

# Optional: force using ethereal (test account) for development
# USE_ETHEREAL=true

# Optional timeouts (milliseconds, helpful for flaky networks)
# SMTP_CONNECTION_TIMEOUT=20000
# SMTP_GREETING_TIMEOUT=20000
# SMTP_SOCKET_TIMEOUT=20000

# Frontend URL for CORS (optional)
# FRONTEND_URL=http://localhost:5173

# Server port (default 4000)
PORT=4000

# Example minimal .env for local Gmail testing (UNCOMMENT and fill values):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=your-email@gmail.com
# TO_EMAIL=keithardeelazo@gmail.com

# If you don't want to send real emails during local dev, set:
# USE_ETHEREAL=true
