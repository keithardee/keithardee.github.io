# Copy to .env and fill values before starting server
PORT=4000

# SMTP settings for sending mail (e.g., Gmail app password or SMTP provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# From/To addresses
FROM_EMAIL="no-reply@yourdomain.com"
TO_EMAIL="your-email@example.com"
