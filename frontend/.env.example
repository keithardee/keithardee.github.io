# Example frontend env for Vite
# Copy to web/.env and set VITE_API_URL for local development
# VITE_API_URL is used by the frontend to POST to your backend contact API
VITE_API_URL=http://localhost:4000
# Example environment variables for local use — do NOT commit your real token here.
# Copy this file to .env and replace values with your secrets.

# GitHub Personal Access Token (fine-grained) with Pages write permission
# GITHUB_TOKEN=ghp_xxx

# Other env vars can go here
# NODE_ENV=development

# Backend API URL for contact form
# VITE_API_URL=http://localhost:4000
